# Modèle de configuration locale. Copier vers `.env` (déjà ignoré par Git) :
#   cp .env.example .env
# Aucune valeur ne doit être versionnée.

# --- Obligatoire ---
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# Chiffrer les clés fournisseur en base. Toute rotation rend les clés existantes
# illisibles : voir RENDER.md avant de la changer.
FERNET_KEY=
SECRET_KEY=

# --- Base de données ---
# Absent -> SQLite (db.sqlite3). Recommandé en production.
# DATABASE_URL=postgresql://postgres:mot_de_passe@127.0.0.1:5432/ai_2ai

# --- Exécution ---
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://ton-domaine.example

# --- Modèles : OpenRouter (texte, image, vidéo) ---
# OPENROUTER_API_KEY=
# OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
# OPENROUTER_VIDEO_MODEL=alibaba/wan-3.0

# --- Modèles : audio ---
# FAL_API_KEY=
# REPLICATE_API_TOKEN=
# APIFRAME_API_KEY=

# --- Paiements ---
# DEFAULT_CURRENCY=XOF
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYDUNYA_MASTER_KEY=
# PAYDUNYA_PRIVATE_KEY=
# PAYDUNYA_TOKEN=
# PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- Connexions tierces (facultatives) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# --- Cache et limitation de débit ---
# Sans REDIS_URL, Django retombe sur un cache local par processus :
# la limitation de débit n'est alors plus partagée ni persistante.
# REDIS_URL=redis://127.0.0.1:6379/0

# --- Continuité des conversations (compression locale, sans appel IA) ---
# CHAT_HISTORY_MAX_MESSAGES=48
# CHAT_HISTORY_MAX_CHARS=48000
# Résumé et rappel des anciens messages inclus dans le budget d'historique.
# CHAT_CONTEXT_SUMMARY_MAX_CHARS=5000
# CHAT_CONTEXT_RECALL_MAX_CHARS=6000
# Extraits des autres conversations du même persona/espace ; 0 pour désactiver.
# CHAT_CONTEXT_RELATED_MAX_CHARS=6000

# --- Authentification ---
# AUTH_MAX_FAILURES=10
# AUTH_FAILURE_WINDOW_SECONDS=300
# SIGNUP_MAX_PER_WINDOW=5
# SIGNUP_WINDOW_SECONDS=3600
# A n'activer que derrière un proxy de confiance (sinon l'en-tête est falsifiable).
# TRUST_X_FORWARDED_FOR=False

# --- Messagerie (mot de passe oublié) ---
# Sans SMTP configuré, la réinitialisation par e-mail est indisponible.
# EMAIL_URL=smtp://user:mot-de-passe@smtp.example:587
# DEFAULT_FROM_EMAIL=2AI <no-reply@example.test>

# --- Exécution de code Bara (désactivée par défaut) ---
# BARA_CODE_EXECUTION_ENABLED=False
# BARA_SANDBOX_IMAGE=ai2ai-runtime:1

# --- Comparaisons / évaluations (activation explicite uniquement) ---
COMPARISON_ENABLED=False
COMPARISON_AUTOMATIC_ENABLED=False
EVALUATION_REWARDS_ENABLED=False
EVALUATION_ROUTING_ENABLED=False
# Autoriser les fournisseurs/modèles après revue de leurs conditions :
# COMPARISON_PROVIDER_ALLOWLIST=openrouter
# COMPARISON_MODEL_ALLOWLIST=publisher/model-a,publisher/model-b
# COMPARISON_MODEL_DENYLIST=
# COMPARISON_MAX_OUTPUT_TOKENS=1024
# COMPARISON_MAX_PROMPT_CHARS=8000
# COMPARISON_MAX_CREDITS=500
# COMPARISON_AUTOMATIC_MAX_CREDITS=150
# COMPARISON_USER_DAILY_CREDITS=2000
# COMPARISON_GLOBAL_DAILY_CREDITS=20000
# COMPARISON_RATE_LIMIT=3
# COMPARISON_STALE_SECONDS=600
# COMPARISON_MAX_CANDIDATES=80
# COMPARISON_EXPLORATION_RATE=0.2
# EVALUATION_VOTE_RATE_LIMIT=10
# EVALUATION_MIN_READING_SECONDS=5
# EVALUATION_REWARD_MIN_ACCOUNT_DAYS=7
# EVALUATION_REWARD_CREDITS=10
# EVALUATION_DAILY_REWARD_LIMIT=3
# EVALUATION_MONTHLY_REWARD_LIMIT=30
# EVALUATION_GLOBAL_REWARD_BUDGET=0
# EVALUATION_RETENTION_DAYS=90
# EVALUATION_ANALYSIS_MAX_VOTES=5000
# EVALUATION_ROUTING_MIN_USERS=10
# EVALUATION_ROUTING_MIN_SAMPLES=30
