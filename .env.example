# Modèle de configuration locale. Copier vers `.env` (déjà ignoré par Git) :
#   cp .env.example .env
# Aucune valeur ne doit être versionnée.

# --- Obligatoire ---
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# Chiffrer les clés fournisseur en base. Toute rotation rend les clés existantes
# illisibles : voir RENDER.md avant de la changer.
FERNET_KEY=
SECRET_KEY=

# --- Base de données ---
# Absent -> SQLite (db.sqlite3). Recommandé en production.
# DATABASE_URL=postgresql://postgres:mot_de_passe@127.0.0.1:5432/ai_2ai

# --- Exécution ---
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://ton-domaine.example

# --- Modèles : OpenRouter (texte, image, vidéo) ---
# OPENROUTER_API_KEY=
# OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
# OPENROUTER_VIDEO_MODEL=alibaba/wan-3.0

# --- Modèles : audio ---
# FAL_API_KEY=
# REPLICATE_API_TOKEN=
# APIFRAME_API_KEY=

# --- Paiements ---
# DEFAULT_CURRENCY=XOF
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYDUNYA_MASTER_KEY=
# PAYDUNYA_PRIVATE_KEY=
# PAYDUNYA_TOKEN=
# PUBLIC_BASE_URL=http://127.0.0.1:8000

# --- Connexions tierces (facultatives) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# --- Cache et limitation de débit ---
# Sans REDIS_URL, Django retombe sur un cache local par processus :
# la limitation de débit n'est alors plus partagée ni persistante.
# REDIS_URL=redis://127.0.0.1:6379/0

# --- Authentification ---
# AUTH_MAX_FAILURES=10
# AUTH_FAILURE_WINDOW_SECONDS=300
# SIGNUP_MAX_PER_WINDOW=5
# SIGNUP_WINDOW_SECONDS=3600
# A n'activer que derrière un proxy de confiance (sinon l'en-tête est falsifiable).
# TRUST_X_FORWARDED_FOR=False

# --- Messagerie (mot de passe oublié) ---
# Sans SMTP configuré, la réinitialisation par e-mail est indisponible.
# EMAIL_URL=smtp://user:mot-de-passe@smtp.example:587
# DEFAULT_FROM_EMAIL=2AI <no-reply@example.test>

# --- Exécution de code Bara (désactivée par défaut) ---
# BARA_CODE_EXECUTION_ENABLED=False
# BARA_SANDBOX_IMAGE=ai2ai-runtime:1
